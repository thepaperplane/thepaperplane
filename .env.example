# =============================================================================
# The Paper Plane — environment
# Copy to .env.local for development. Set the same keys in Vercel for prod.
# =============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.thepaperplane.co.in"

# --- Supabase ---------------------------------------------------------------
# Project: "The Paper Plane Website" (ap-south-1)
# Publishable key is safe to expose — it ships to the browser and is governed
# by row level security.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# SECRET. Bypasses row level security. Server-side only — never prefix with
# NEXT_PUBLIC_ and never commit a real value.
# Supabase dashboard → Project Settings → API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=""

# --- Email (Resend) ---------------------------------------------------------
# Used for the monthly compliance calendar and enquiry notifications.
RESEND_API_KEY=""
EMAIL_FROM="The Paper Plane <calendar@thepaperplane.co.in>"
EMAIL_REPLY_TO="contact@thepaperplane.co.in"
# Where new website enquiries are delivered internally.
ENQUIRY_NOTIFY_TO="contact@thepaperplane.co.in"

# --- Portfolio screenshot capture -------------------------------------------
# ScreenshotOne (https://screenshotone.com) — free tier covers this use.
SCREENSHOT_API_KEY=""

# --- Scheduled jobs ---------------------------------------------------------
# Shared secret so only Vercel Cron can trigger /api/cron/*.
# Generate with:  openssl rand -hex 32
CRON_SECRET=""

# --- Console security --------------------------------------------------------
# Two-factor sign-in is required for the admin console. Set to "false" ONLY as
# a temporary escape hatch if the authenticator phone is lost, then remove it.
# CONSOLE_REQUIRE_MFA="true"
