# =============================================================================
# The Paper Plane — environment
# Copy to .env.local for development. Set the same keys in Vercel for prod.
# =============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.thepaperplane.co.in"

# --- Supabase ---------------------------------------------------------------
# Project: "The Paper Plane Website" (ap-south-1)
# Publishable key is safe to expose — it ships to the browser and is governed
# by row level security.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# SECRET. Bypasses row level security. Server-side only — never prefix with
# NEXT_PUBLIC_ and never commit a real value.
# Supabase dashboard → Project Settings → API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=""

# --- Email (Resend) ---------------------------------------------------------
# Used for the monthly compliance calendar and enquiry notifications.
RESEND_API_KEY=""
EMAIL_FROM="The Paper Plane <calendar@thepaperplane.co.in>"
EMAIL_REPLY_TO="contact@thepaperplane.co.in"
# Where new website enquiries are delivered internally.
ENQUIRY_NOTIFY_TO="contact@thepaperplane.co.in"

# --- Portfolio screenshot capture -------------------------------------------
# ScreenshotOne (https://screenshotone.com) — free tier covers this use.
SCREENSHOT_API_KEY=""

# --- Scheduled jobs ---------------------------------------------------------
# Shared secret so only Vercel Cron can trigger /api/cron/*.
# Generate with:  openssl rand -hex 32
CRON_SECRET=""

# --- Console security --------------------------------------------------------
# Two-factor sign-in is required for the admin console. Set to "false" ONLY as
# a temporary escape hatch if the authenticator phone is lost, then remove it.
# CONSOLE_REQUIRE_MFA="true"

# --- Site assistant (Anthropic Claude) ---------------------------------------
# console.anthropic.com → API keys. Without it the assistant simply does not
# appear. Switch it on/off and set its limits in the console → Site assistant.
ANTHROPIC_API_KEY=""
# The model is chosen in the console → Site assistant → "Quality and cost"
# (Economy = Claude Haiku 4.5 by default; it also drives the WhatsApp
# assistant). Setting ASSISTANT_MODEL overrides that choice — leave it unset.
# ASSISTANT_MODEL=""
# Optional salt for the one-way hash of visitor IPs used for daily limits.
# ASSISTANT_SALT=""

# --- Integrations ------------------------------------------------------------
# Encrypts stored integration tokens (any long random string).
# Generate with:  openssl rand -base64 48
INTEGRATIONS_KEY=""

# Zoho CRM + Zoho Books. api-console.zoho.in → Server-based Applications.
# Redirect URI: https://www.thepaperplane.co.in/api/admin/integrations/zoho/callback
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
# Data centre of the Zoho account: in (India), com, eu, com.au …
ZOHO_DC="in"
# Optional. Only if the callback must go to a fixed domain (e.g. previews).
# ZOHO_REDIRECT_ORIGIN="https://www.thepaperplane.co.in"
# Optional. Your Zoho Books client portal address, shown to signed-in clients
# as "Open the Zoho portal" (Zoho Books → Settings → Customer Portal).
# ZOHO_PORTAL_URL="https://books.zoho.in/portal/thepaperplane"

# Google Calendar (meetings booked on /book and by the WhatsApp assistant).
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (Web application). Enable "Google Calendar API".
# Redirect URI: https://www.thepaperplane.co.in/api/admin/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_ORIGIN="https://www.thepaperplane.co.in"

# WhatsApp Business (Meta Cloud API) — the NEW assistant number only.
# NEVER register 9025565526 here: adding a number to the Cloud API removes it
# from the WhatsApp app on the phone. Webhook URL:
# https://www.thepaperplane.co.in/api/whatsapp/webhook
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
